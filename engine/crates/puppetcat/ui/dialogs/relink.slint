import { Theme } from "../theme/theme.slint";
import { Glyph } from "../icons.slint";
import { Button, DialogRow, DialogSection, Field, Modal } from "../primitives/modal.slint";

// The relink sheet: media whose files have moved, pointed at where they are
// now. Either swap the folder they used to live in for the one they live in
// now, or locate a file for one item. Nothing is changed until every
// replacement checks out.

export struct RelinkRowData {
    name: string,
    old-path: string,
    new-path: string,
    /// `missing` before anything is chosen, then `ok`, `unreadable`,
    /// `incompatible` or `missing` again for a chosen file that is not there
    status: string,
    reason: string,
}

export struct RelinkData {
    open: bool,
    /// the folder the missing files used to be in
    old-root: string,
    /// the folder they are in now
    new-root: string,
    /// "3 of 5 will be relinked"
    summary: string,
    busy: bool,
    can-apply: bool,
}

component FileRow inherits Rectangle {
    in property <RelinkRowData> entry;
    callback locate();

    height: 44px;
    background: Theme.raised;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.entry.name;
                color: Theme.fg;
                font-size: Theme.fs;
                font-weight: Theme.weight-title;
                overflow: elide;
            }

            Text {
                text: root.entry.status == "ok" ? root.entry.new-path
                    : root.entry.reason != "" ? root.entry.reason
                    : root.entry.old-path;
                color: root.entry.status == "ok" ? Theme.green
                    : root.entry.status == "missing" ? Theme.fg-dim
                    : Theme.danger;
                font-family: Theme.font-technical;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                label: "Locate";
                ghost: true;
                clicked => { root.locate(); }
            }
        }
    }
}

export component RelinkDialog inherits Modal {
    in property <RelinkData> data;
    in property <[RelinkRowData]> rows;

    callback old-root-edited(text: string);
    callback new-root-edited(text: string);
    callback browse-root();
    callback locate(index: int);
    callback apply();

    open: root.data.open;
    title: "Relink media";
    glyph: Glyph.import;
    surface-width: 520px;
    note: root.data.summary;

    VerticalLayout {
        DialogSection {
            first: true;
            title: "The folder moved";

            DialogRow {
                label: "Was in";
                Field {
                    value: root.data.old-root;
                    technical: true;
                    edited(text) => { root.old-root-edited(text); }
                }
            }

            DialogRow {
                label: "Now in";
                Field {
                    value: root.data.new-root;
                    technical: true;
                    placeholder: "Choose the new folder";
                    edited(text) => { root.new-root-edited(text); }
                }

                Button {
                    label: "Browse";
                    glyph: Glyph.import;
                    clicked => { root.browse-root(); }
                }
            }
        }

        DialogSection {
            title: "Files";

            Flickable {
                height: Math.min(root.rows.length * 45px, 220px);
                viewport-height: root.rows.length * 45px;

                VerticalLayout {
                    spacing: 1px;
                    for entry[index] in root.rows: FileRow {
                        entry: entry;
                        locate => { root.locate(index); }
                    }
                }
            }

            HorizontalLayout {
                Button {
                    block: true;
                    primary: true;
                    large: true;
                    label: "Relink";
                    enabled: root.data.can-apply && !root.data.busy;
                    clicked => { root.apply(); }
                }
            }
        }
    }
}
