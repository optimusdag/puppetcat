import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";

// The right-click menu: an icon slot every row shares, a label, a right-set
// shortcut hint, checkbox rows, group labels, separators, and one row that may
// be red.
//
// Two constraints shape it:
//
// Submenus are not a row type: a Slint struct cannot hold an array, so a row
// cannot carry its own children. Instead the menu is given one extra list,
// `sub-items`, and the id of the one row (`sub-id`) that opens it beside the
// menu. That is enough for the one place a menu wants a long set of options
// behind a single verb, and everything else stays a flat list of verbs — which
// is what suits a timeline.
//
// The surface is sized by the caller rather than by its content. Summing the
// row heights means looping over a model, which the expression language cannot
// do; whoever builds the items knows what they add up to, and says so.

/// What a row *is*. Only `action` is selectable.
export enum MenuRow {
    action,
    /// a group heading, e.g. SPEED
    label,
    separator,
}

export struct MenuItemData {
    /// Reported on select. Empty for anything that is not an action.
    id: string,
    label: string,
    kind: MenuRow,
    /// leading glyph; rows without one still align, the slot is always there
    glyph: Glyph,
    /// right-set hint, e.g. "Ctrl+C". Display only — bind the key yourself.
    shortcut: string,
    enabled: bool,
    /// paints the row red, for the one row that destroys something
    danger: bool,
    /// turns the row into a checkbox row: the slot carries a tick, not a glyph
    checkable: bool,
    checked: bool,
}

/// Row heights, so the caller can add them up without guessing.
export global MenuMetrics {
    out property <length> action: 26px;
    out property <length> label: 24px;
    out property <length> separator: 9px;
    /// the surface's own padding, top and bottom together
    out property <length> padding: 8px;
    out property <length> width: 212px;
}

/// One column of rows. `sub-id` names a row that opens a submenu rather than
/// selecting: it shows a chevron, and hovering or pressing it asks for the
/// submenu at that row's height.
component MenuPanel inherits Rectangle {
    in property <[MenuItemData]> items;
    in property <string> sub-id;
    /// Which submenu row is showing its submenu, for the pressed look.
    in property <bool> sub-open;

    callback selected(id: string);
    /// The submenu row was hovered or pressed; `y` is its top in this panel.
    callback sub-asked(y: length);
    /// Another action row was hovered, so an open submenu should close.
    callback other-hovered();

    VerticalLayout {
        padding: 4px;
        alignment: start;

        for item in root.items: slot := Rectangle {
            height: item.kind == MenuRow.separator ? MenuMetrics.separator
                : item.kind == MenuRow.label ? MenuMetrics.label
                : MenuMetrics.action;

            if item.kind == MenuRow.separator: Rectangle {
                x: 6px;
                y: (parent.height - 1px) / 2;
                width: parent.width - 12px;
                height: 1px;
                background: Theme.line;
            }

            if item.kind == MenuRow.label: Text {
                x: 8px;
                y: 0;
                width: parent.width - 16px;
                height: parent.height;
                text: item.label;
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                letter-spacing: 0.72px;
                vertical-alignment: bottom;
                overflow: elide;
            }

            if item.kind == MenuRow.action: row := Rectangle {
                property <bool> opens: root.sub-id != "" && item.id == root.sub-id;

                border-radius: Theme.r-xs;
                background: !((touch.has-hover || (row.opens && root.sub-open)) && item.enabled)
                    ? Colors.transparent
                    : item.danger ? Theme.danger-soft
                    : Theme.field;

                property <brush> ink: !item.enabled ? Theme.fg-dim
                    : (item.danger && touch.has-hover) ? Theme.danger
                    : Theme.fg;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    // A fixed slot even when a row has no mark, so every label
                    // starts on the same x. Ragged labels are what make a menu
                    // feel thrown together.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 14px;
                            height: 14px;

                            if item.checkable && item.checked: Icon {
                                x: 0;
                                y: 0;
                                glyph: Glyph.check;
                                size: 13px;
                                tint: item.enabled ? Theme.accent : Theme.fg-dim;
                            }

                            if !item.checkable && item.glyph != Glyph.none: Icon {
                                x: 0;
                                y: 0;
                                glyph: item.glyph;
                                size: 13px;
                                tint: item.enabled ? Theme.fg-muted : Theme.fg-dim;
                            }
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: item.label;
                        color: row.ink;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if item.shortcut != "" && !row.opens: Text {
                        text: item.shortcut;
                        color: item.enabled ? Theme.fg-dim : Theme.line-strong;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }

                    if row.opens: VerticalLayout {
                        alignment: center;
                        Icon {
                            glyph: Glyph.chevron-right;
                            size: 12px;
                            tint: item.enabled ? Theme.fg-muted : Theme.fg-dim;
                        }
                    }
                }

                touch := TouchArea {
                    enabled: item.enabled;
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if (self.has-hover) {
                            if (row.opens) {
                                root.sub-asked(slot.y + 4px);
                            } else {
                                root.other-hovered();
                            }
                        }
                    }
                    clicked => {
                        if (row.opens) {
                            root.sub-asked(slot.y + 4px);
                        } else {
                            // Report first, then close: the row's data is
                            // certain while the row still exists.
                            root.selected(item.id);
                        }
                    }
                }
            }
        }
    }
}

export component ContextMenu inherits Rectangle {
    in property <[MenuItemData]> items;
    /// The summed height of `items` plus MenuMetrics.padding.
    in property <length> menu-height;
    /// The id of the row that opens `sub-items` beside the menu, or empty for
    /// a menu with no submenu.
    in property <string> sub-id;
    in property <[MenuItemData]> sub-items;
    /// The summed height of `sub-items` plus MenuMetrics.padding.
    in property <length> sub-height;

    callback selected(id: string);

    /// Where the menu was asked for, in this element's own coordinates.
    property <length> at-x;
    property <length> at-y;
    property <bool> sub-open;
    property <length> sub-y;
    property <bool> has-sub: root.sub-id != "" && root.sub-items.length > 0;
    /// The surface is as wide as both panels when there is a submenu to show,
    /// and as tall as the taller of the two.
    property <length> surface-width: root.has-sub ? MenuMetrics.width * 2 - 2px : MenuMetrics.width;
    property <length> surface-height: root.has-sub ? Math.max(root.menu-height, root.sub-height) : root.menu-height;

    /// Opened by a token rather than a flag: the surface can be dismissed by a
    /// click outside without telling anyone, so a boolean the caller sets would
    /// go stale and the next request at the same spot would be a no-op.
    in property <int> token;
    in property <length> request-x;
    in property <length> request-y;

    changed token => {
        // Nothing to show is not a menu. Whoever bumps the token may find it
        // has no rows to offer — a clip that has gone, a selection with
        // nothing to say — and an empty surface hanging under the pointer is
        // worse than none. It also lets a caller bump unconditionally, which
        // is what keeps the arming in lanes.slint honest.
        if (root.token > 0 && root.items.length > 0) {
            // Flipped back over the pointer near an edge, so the menu is
            // always fully on screen and always touching the click.
            root.at-x = root.request-x + root.surface-width > root.width
                ? Math.max(0px, root.request-x - root.surface-width)
                : root.request-x;
            root.at-y = root.request-y + root.surface-height > root.height
                ? Math.max(0px, root.request-y - root.surface-height)
                : root.request-y;
            root.sub-open = false;
            surface.show();
        }
    }

    background: transparent;

    surface := PopupWindow {
        x: root.at-x;
        y: root.at-y;
        width: root.surface-width;
        height: root.surface-height;
        close-policy: close-on-click-outside;

        main := Rectangle {
            x: 0;
            y: 0;
            width: MenuMetrics.width;
            height: root.menu-height;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-radius: Theme.r;
            clip: true;

            MenuPanel {
                items: root.items;
                sub-id: root.has-sub ? root.sub-id : "";
                sub-open: root.sub-open;
                selected(id) => {
                    root.selected(id);
                    surface.close();
                }
                sub-asked(y) => {
                    root.sub-y = y;
                    root.sub-open = true;
                }
                other-hovered => { root.sub-open = false; }
            }
        }

        if root.has-sub && root.sub-open: Rectangle {
            x: MenuMetrics.width - 2px;
            // Level with the row that opened it, pulled up if it would run
            // past the bottom of the surface.
            y: Math.max(0px, Math.min(root.sub-y - 4px, root.surface-height - root.sub-height));
            width: MenuMetrics.width;
            height: root.sub-height;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-radius: Theme.r;
            clip: true;

            MenuPanel {
                items: root.sub-items;
                selected(id) => {
                    root.selected(id);
                    surface.close();
                }
            }
        }
    }
}
